# Copy to configs/qrl_queue.env. These paths are resolved relative to the
# repository root, so the default layout needs no machine-specific edits.

GPU_IDS="0 1 2 3 4 5 6 7"
# Run one allocation round, then wait two minutes before re-checking GPUs.
POLL_SECONDS=120
WATCH_SECONDS=30
# Estimate remaining time from the latest 5k progress units (online env steps).
ETA_WINDOW_STEPS=5000
ETA_SAMPLE_FILE="runs/qrl_queue/status/watch_eta_samples.json"
# Sample per-process GPU memory between allocation passes and retain the peak.
GPU_MEMORY_SAMPLE_SECONDS=5
# GPUs at or above 70% utilization are ineligible.
GPU_UTIL_LIMIT_PCT=70
# Cap concurrent tasks per GPU to avoid CPU environment-worker contention;
# set to 0 only when an unlimited per-GPU queue is intended.
MAX_JOBS_PER_GPU=3
# Choose this so GPU count x MAX_JOBS_PER_GPU x CPU_THREADS_PER_TASK leaves
# enough logical CPUs for the scheduler and system services.
CPU_THREADS_PER_TASK=4
# Compatibility with older queue runners; the current runner keeps this and
# the other numerical-library thread pools synchronized.
OMP_NUM_THREADS=4
# GPUs at or above 70% memory usage are ineligible.
GPU_MEM_LIMIT_PCT=70
# GSD needs a mostly idle GPU to avoid its first-batch IQE OOM.
GSD_MAX_PRELAUNCH_MEM_MB=4000
# Other users' processes still count toward used memory, but are not managed.
IGNORE_EXTERNAL_GPU_USERS=1
GPU_START_COOLDOWN_SECONDS=120
STRICT_GPU_STATE_SYNC=1
TERMINATE_DISALLOWED_GPU_JOBS=1
STOP_ON_FAILURE=0
RETRY_FAILED=0
REQUEUE_TRANSIENT_FAILURES=1
REQUEUE_CUDA_OOM=1
MAX_TRANSIENT_RETRIES=10
DRY_RUN=0

# Optional phone notifications. ServerChan Turbo is convenient for WeChat on
# Android in mainland China. Keep secrets in the ignored qrl_queue.env only.
SERVERCHAN_SENDKEY=""
# Machine name prefixed to every notification title; defaults to OS hostname.
NOTIFY_HOST_LABEL=""
# ntfy remains available as an alternative when SERVERCHAN_SENDKEY is empty.
NTFY_TOPIC_URL=""
# Set this only for an authenticated/self-hosted topic.
NTFY_TOKEN=""
NOTIFY_TIMEOUT_SECONDS=10
# Optional backlog-drained notification. Keep disabled because RUNNING tasks may
# still be training after the PENDING count reaches zero.
NOTIFY_NO_PENDING=0
# Optional extra notifications; disabled to avoid one push per training task.
NOTIFY_TASK_DONE=0
# FAILED/PAUSED tasks from the same scheduler cycle are combined into one push.
NOTIFY_TASK_FAILED=1
# Notify only after every task is terminal and no training process remains.
NOTIFY_QUEUE_DONE=1
# Defaults to STATUS_DIR/notifications.json when empty.
NOTIFY_STATE_FILE=""

QRL_OFFICIAL_DIR="."
QRL_PYTHON_BIN=".venv/bin/python"
TASKS_FILE="runs/qrl_queue/tasks.tsv"
LOG_DIR="logs/qrl_queue"
STATUS_DIR="runs/qrl_queue/status"
RESULTS_ROOT="../qrl-assets/results/queue"
# Optional mirror of newly completed task directories to remote storage. Create
# the local-only baseline before enabling this so historical outputs are not
# uploaded. Verified local results are retained; this is not remote-only output.
REMOTE_RESULTS_SYNC_ENABLED=0
REMOTE_RESULTS_SYNC_HOST=""
REMOTE_RESULTS_SYNC_PORT=22
REMOTE_RESULTS_SYNC_USER=""
REMOTE_RESULTS_SYNC_ROOT=""
REMOTE_RESULTS_SYNC_KEY=""
REMOTE_RESULTS_SYNC_KNOWN_HOSTS=""
REMOTE_RESULTS_SYNC_BASELINE_FILE=""
REMOTE_RESULTS_SYNC_TIMEOUT_SECONDS=300
REMOTE_RESULTS_SYNC_MAX_PER_PASS=2
ALLOW_EXISTING_INCOMPLETE_OUTPUT=1
RESUME_IF_POSSIBLE=1
OVERWRITE_OUTPUT=False
# Exact online resume needs replay data in both periodic and final checkpoints.
ONLINE_SAVE_REPLAY_BUFFER=True
ONLINE_SAVE_FINAL_REPLAY_BUFFER=True

DEVICE_INDEX=0
EGL_DEVICE_ID=0
RENDER_GPUS=0
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl

D4RL_DATASET_DIR="../qrl-assets/d4rl/datasets"
D4RL_SUPPRESS_IMPORT_ERROR=1
MUJOCO_PY_MUJOCO_PATH="../qrl-assets/mujoco/mujoco210"
MUJOCO_PATH="../qrl-assets/mujoco/mujoco210"
